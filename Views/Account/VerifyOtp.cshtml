@model CNPM_Nhom12.ViewModels.VerifyOtpViewModel
@{
    ViewData["Title"] = "Xác thực OTP";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
                <h4 class="card-title mb-1">Xác thực email</h4>
                <p class="text-muted small mb-4">
                    Mã OTP gồm 6 chữ số đã được gửi đến<br />
                    <strong>@Model.Email</strong><br />
                    Mã có hiệu lực trong 5 phút.
                </p>

                <form asp-action="VerifyOtp" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Otp" class="form-label">Mã OTP</label>
                        <input asp-for="Otp" class="form-control form-control-lg text-center"
                               maxlength="6" placeholder="______"
                               style="letter-spacing: 0.4rem; font-size: 1.4rem;" />
                        <span asp-validation-for="Otp" class="text-danger small"></span>
                    </div>
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success btn-lg">Xác nhận</button>
                    </div>
                    <div class="text-center small">
                        <a asp-action="Register">← Quay lại đăng ký</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}