@inject Microsoft.AspNetCore.Identity.UserManager<CNPM_Nhom12.Models.ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var fullName = currentUser?.FullName ?? User.Identity?.Name ?? "Người dùng";
    var initials = string.Concat(fullName.Split(' ').Where(w => w.Length > 0).TakeLast(2).Select(w => w[0])).ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SpendWise — @ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@latest/tabler-icons.min.css">
    <link rel="stylesheet" href="~/css/spendwise.css" asp-append-version="true">
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="app">

        <aside class="sidebar">
            <div class="sidebar-logo">
                <div class="logo-icon"><i class="ti ti-wallet"></i></div>
                <div>
                    <div class="logo-text">SpendWise</div>
                    <div class="logo-sub">Quản lý chi tiêu</div>
                </div>
            </div>
            <nav class="nav">
                <div class="nav-label">Chính</div>
                <a class="sw-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="ti ti-layout-dashboard"></i> Tổng quan
                </a>
                <a class="sw-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transactions" ? "active" : "")"
                   asp-controller="Transactions" asp-action="Index">
                    <i class="ti ti-list"></i> Giao dịch
                </a>
                <div class="nav-label">Quản lý</div>
                <a class="sw-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"
                   asp-controller="Categories" asp-action="Index">
                    <i class="ti ti-tag"></i> Danh mục
                </a>
                <a class="sw-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Budget" ? "active" : "")"
                   asp-controller="Budget" asp-action="Index">
                    <i class="ti ti-target"></i> Hạn mức chi tiêu
                </a>
                <div class="nav-label">Phân tích</div>
                <a class="sw-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                   asp-controller="Reports" asp-action="Index">
                    <i class="ti ti-chart-bar"></i> Báo cáo tài chính
                </a>
            </nav>
            <div class="sidebar-footer">
                <div class="user-chip">
                    <div class="avatar">@initials</div>
                    <div style="flex:1;min-width:0">
                        <div class="user-name">@fullName</div>
                        <div class="user-role">Tài khoản cá nhân</div>
                    </div>
                    <div class="user-menu-wrap">
                        <button class="user-menu-btn" id="userMenuBtn" title="Tùy chọn">
                            <i class="ti ti-dots"></i>
                        </button>
                        <div class="user-menu-dropdown" id="userMenuDropdown">
                            <a class="user-menu-item" asp-controller="Home" asp-action="Index">
                                <i class="ti ti-layout-dashboard"></i> Tổng quan
                            </a>
                            <div class="user-menu-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="user-menu-item user-menu-logout">
                                    <i class="ti ti-logout"></i> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <style>
                .user-chip {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    position: relative;
                }

                .user-menu-wrap {
                    position: relative;
                }

                .user-menu-btn {
                    background: none;
                    border: none;
                    color: var(--text3);
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 16px;
                    transition: background .15s, color .15s;
                    flex-shrink: 0;
                }

                .user-menu-btn:hover, .user-menu-btn.active {
                    background: var(--surface2);
                    color: var(--text);
                }

                .user-menu-dropdown {
                    display: none;
                    position: absolute;
                    bottom: calc(100% + 8px);
                    right: 0;
                    background: var(--surface);
                    border: 1px solid var(--border);
                    border-radius: var(--radius-lg);
                    box-shadow: 0 8px 24px rgba(0,0,0,.10);
                    min-width: 180px;
                    padding: 6px;
                    z-index: 200;
                }

                .user-menu-dropdown.open {
                    display: block;
                    animation: menuFadeIn .12s ease;
                }

                @@keyframes menuFadeIn {
                    from { opacity: 0; transform: translateY(6px); }
                    to   { opacity: 1; transform: translateY(0); }
                }

                .user-menu-item {
                    display: flex;
                    align-items: center;
                    gap: 9px;
                    width: 100%;
                    padding: 8px 10px;
                    border-radius: 8px;
                    font-size: 13.5px;
                    color: var(--text);
                    text-decoration: none;
                    background: none;
                    border: none;
                    cursor: pointer;
                    transition: background .12s;
                    font-family: inherit;
                }

                .user-menu-item:hover {
                    background: var(--surface2);
                    color: var(--text);
                }

                .user-menu-logout {
                    color: var(--red-dk);
                }

                .user-menu-logout:hover {
                    background: var(--red-bg);
                    color: var(--red-dk);
                }

                .user-menu-divider {
                    height: 1px;
                    background: var(--border);
                    margin: 4px 0;
                }
            </style>

            <script>
                (function () {
                    const btn = document.getElementById('userMenuBtn');
                    const dropdown = document.getElementById('userMenuDropdown');

                    btn.addEventListener('click', function (e) {
                        e.stopPropagation();
                        const isOpen = dropdown.classList.toggle('open');
                        btn.classList.toggle('active', isOpen);
                    });

                    document.addEventListener('click', function () {
                        dropdown.classList.remove('open');
                        btn.classList.remove('active');
                    });
                })();
            </script>
        </aside>

        <div class="main">
            <header class="topbar">
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-actions">
                    <div class="month-chip">
                        <i class="ti ti-calendar"></i> Tháng @DateTime.Now.Month, @DateTime.Now.Year
                    </div>
                    @RenderSection("TopbarActions", required: false)
                </div>
            </header>

            @if (TempData["Success"] != null)
            {
                <div class="toast-success">
                    <i class="ti ti-circle-check"></i> @TempData["Success"]
                </div>
            }

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <script src="~/js/spendwise.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>