@{
    var user = ViewBag.CurrentUser as CNPM_Nhom12.Models.ApplicationUser;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpendWise</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@latest/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/spendwise.css" asp-append-version="true" />
    <style>
        .navbar-legacy-app {
            background: var(--surface) !important;
            border-bottom: 1px solid var(--border);
            box-shadow: none;
        }

        .navbar-legacy-app .navbar-brand {
            font-weight: 700;
            color: var(--text) !important;
        }

        .btn-auth-login {
            background: transparent;
            border: 1.5px solid var(--green);
            color: var(--green);
            border-radius: 8px;
            padding: 6px 18px;
            font-weight: 600;
        }

        .btn-auth-login:hover {
            background: var(--green);
            color: #fff;
        }

        .btn-auth-reg {
            background: var(--green);
            border: none;
            color: #fff;
            border-radius: 8px;
            padding: 6px 18px;
            font-weight: 600;
        }

        .btn-auth-reg:hover {
            background: var(--green-dk);
            color: #fff;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light navbar-legacy-app mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">SpendWise</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="text-muted small">Xin chào, <strong>@User.Identity.Name</strong></span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-auth-login">Đăng xuất</button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn-auth-login" data-auth-open="login">Đăng nhập</button>
                            <button type="button" class="btn-auth-reg" data-auth-open="register">Đăng ký</button>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 SpendWise
        </div>
    </footer>

    @await Component.InvokeAsync("AuthModals", new { theme = "app" })

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/spendwise.js" asp-append-version="true"></script>
    <script src="~/js/auth-modal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
