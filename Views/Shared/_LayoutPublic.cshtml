<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpendWise</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@latest/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/spendwise.css" asp-append-version="true" />
    <style>
        /* ── Reset cho public layout ── */
        html, body {
            height: auto !important;
            min-height: 100vh;
            background: #F5F5F3 !important;
            display: block !important;
            overflow: auto !important;
            flex-direction: unset !important;
        }

        .app { display: block !important; height: auto !important; overflow: auto !important; }

        /* ── Navbar ── */
        .pub-nav {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
            padding: 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 60px;
        }

        .pub-nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .pub-nav-logo .logo-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: var(--green);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 17px;
        }

        .pub-nav-logo .logo-text {
            font-size: 16px;
            font-weight: 700;
            color: var(--text);
        }

        .pub-nav-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-nav-login {
            background: transparent;
            border: 1.5px solid var(--green);
            color: var(--green);
            border-radius: 8px;
            padding: 7px 18px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all .15s;
        }

        .btn-nav-login:hover {
            background: var(--green);
            color: #fff;
        }

        .btn-nav-reg {
            background: var(--green);
            border: none;
            color: #fff;
            border-radius: 8px;
            padding: 7px 18px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: background .15s;
        }

        .btn-nav-reg:hover {
            background: var(--green-dk);
        }

        /* ── Content area ── */
        .pub-content {
            min-height: calc(100vh - 60px - 56px);
        }

        /* ── Footer ── */
        .pub-footer {
            border-top: 1px solid var(--border);
            padding: 16px 32px;
            text-align: center;
            font-size: 13px;
            color: var(--text3);
        }

    </style>
</head>
<body>

    <!-- ── Navbar ── -->
    <nav class="pub-nav">
        <a class="pub-nav-logo" asp-controller="Home" asp-action="Index">
            <div class="logo-icon"><i class="ti ti-wallet"></i></div>
            <span class="logo-text">SpendWise</span>
        </a>
        <div class="pub-nav-actions">
            <button type="button" class="btn-nav-login" data-auth-open="login">
                Đăng nhập
            </button>
            <button type="button" class="btn-nav-reg" data-auth-open="register">
                Đăng ký miễn phí
            </button>
        </div>
    </nav>

    <!-- ── Page content ── -->
    <div class="pub-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>

    <!-- ── Footer ── -->
    <footer class="pub-footer">
        &copy; 2026 SpendWise — Quản lý chi tiêu thông minh
    </footer>

    @await Component.InvokeAsync("AuthModals", new { theme = "public" })

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/auth-modal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
